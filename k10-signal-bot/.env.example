# ── K10 Bot — Variáveis de Ambiente ─────────────────────────────────────────
# Copie este arquivo para .env e preencha os valores

# Token do bot (obtenha com @BotFather no Telegram)
BOT_TOKEN=seu_token_aqui

# Chat IDs autorizados (separados por vírgula, deixe vazio para todos)
# Ex: 123456789,-987654321
ALLOWED_CHAT_IDS=

# Exchange (binance, mexc, bybit, etc.)
EXCHANGE=binance

# Quality Gate
RR_MINIMO=2.0
ADX_MINIMO_TENDENCIA=25.0
RVOL_MINIMO=1.0
SCORE_MINIMO=55
